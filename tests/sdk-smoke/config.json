{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sdk-smoke",
        "Queues": [
          {
            "Name": "smoke-queue",
            "Properties": {
              "LockDuration": "PT30S",
              "MaxDeliveryCount": 5
            }
          },
          {
            "Name": "smoke-sessions",
            "Properties": {
              "LockDuration": "PT30S",
              "MaxDeliveryCount": 5,
              "RequiresSession": true
            }
          }
        ],
        "Topics": [
          {
            "Name": "smoke-topic",
            "Subscriptions": [
              {
                "Name": "smoke-topic-sessions",
                "Properties": {
                  "LockDuration": "PT30S",
                  "MaxDeliveryCount": 5,
                  "RequiresSession": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
