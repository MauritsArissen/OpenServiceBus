<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenServiceBus.Explorer</RootNamespace>
    <Description>Browser-based explorer for testing OpenServiceBus features against the real Azure.Messaging.ServiceBus SDK.</Description>
    <IsPackable>false</IsPackable>
    <!-- The React/shadcn SPA lives in ui/ and builds into wwwroot (git-ignored). The npm
         build is OPT-IN (set BuildExplorerUi=true) so a plain dotnet build / CI never needs
         Node and never races the static-web-assets pipeline. The Docker image builds the
         SPA in a dedicated node stage; for local dotnet run, build it once inside ui/
         with npm ci and npm run build. -->
    <BuildExplorerUi Condition="'$(BuildExplorerUi)' == ''">false</BuildExplorerUi>
    <SpaRoot>$(MSBuildProjectDirectory)/ui</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenServiceBus.Explorer.Tests" />
  </ItemGroup>

  <!-- Build the SPA into wwwroot before Build/Publish. Runs npm ci + npm run build.
       Guarded by BuildExplorerUi and skipped if node_modules is fresh relative to sources. -->
  <Target Name="BuildExplorerSpa" BeforeTargets="AssignTargetPaths"
          Condition="'$(BuildExplorerUi)' == 'true' And Exists('$(SpaRoot)/package.json')">
    <Message Importance="high" Text="Building Explorer UI (npm) from $(SpaRoot)…" />
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)"
          Condition="!Exists('$(SpaRoot)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>
